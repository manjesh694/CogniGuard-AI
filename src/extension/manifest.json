{
  "manifest_version": 3,
  "name": "CogniGuard AI - Zero-Entry Gatekeeper",
  "version": "1.0.1",
  "description": "Autonomous Zero-Entry Browser Guardian preventing infostealers, malicious downloads, and credential theft.",
  "permissions": [
    "downloads",
    "storage",
    "webNavigation",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon128.png",
    "default_title": "CogniGuard AI Protection: Active"
  }
}
